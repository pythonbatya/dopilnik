{
  "name": "reveal",
  "displayName": "reveal",
  "description": "Title-bar button for the Explorer file tree: reveal the active editor file on demand — pairs with explorer.autoReveal=false",
  "version": "0.1.1",
  "publisher": "lvinogradov",
  "engines": { "vscode": "^1.93.0" },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "reveal.activeFile", "title": "Reveal: active file in Explorer", "icon": "$(target)" }
    ],
    "menus": {
      "view/title": [
        { "command": "reveal.activeFile", "when": "view == 'workbench.explorer.fileView'", "group": "navigation" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no unit tests — vscode layer only' && exit 0",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
