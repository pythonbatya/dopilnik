{
  "manifest_version": 3,
  "name": "dopilnik sync",
  "version": "0.1.0",
  "description": "Automatically exports bookmarks and open tabs to files in the Downloads folder.",
  "permissions": ["bookmarks", "tabs", "downloads", "storage", "alarms"],
  "browser_specific_settings": {
    "gecko": {
      "id": "dopilnik-sync@local",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "dopilnik sync"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  }
}
